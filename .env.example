# Attrad - Environment Variables Example
# Copia este archivo a .env.local para configurar tu conexión a Supabase real cuando desees.

# Supabase Project URL y Clave Anónima Pública
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key_publica

# Endpoint para ingesta de leads (Edge Function o API Route)
VITE_INGESTION_ENDPOINT=https://tu-proyecto.supabase.co/functions/v1/capture-lead

# Modo de almacenamiento: 'hybrid' (Usa LocalStorage/memoria si no hay credenciales válidas) o 'supabase' (Solo Supabase)
VITE_STORAGE_MODE=hybrid
